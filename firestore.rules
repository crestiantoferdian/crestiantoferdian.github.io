rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // LLK V1 (Guru Lepas) — TIDAK DIUBAH
    // ═══════════════════════════════════════════════════════════════

    // Status langganan: user cuma boleh BACA datanya sendiri.
    // Menulis HANYA boleh dari Cloud Function (Admin SDK, bypass rules ini).
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Data order/transaksi: tidak diakses langsung oleh client sama sekali.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // Catatan email yang sudah pernah memakai trial (hanya Cloud Function).
    match /trialUsage/{key} {
      allow read, write: if false;
    }

    // Backup data Guru Lepas (murid/absensi dll)
    match /backups/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ═══════════════════════════════════════════════════════════════
    // LLK V2 (Lembaga: Guru Admin + Guru Mitra)
    // ═══════════════════════════════════════════════════════════════

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function orgPath(orgId) { return /databases/$(database)/documents/orgs/$(orgId); }
    function memberPath(orgId, u) { return /databases/$(database)/documents/orgs/$(orgId)/members/$(u); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function userPath(u) { return /databases/$(database)/documents/users/$(u); }
    function isMember(orgId) { return signedIn() && exists(memberPath(orgId, uid())); }
    function isAdmin(orgId) {
      return signedIn() && exists(memberPath(orgId, uid()))
        && get(memberPath(orgId, uid())).data.role == 'admin';
    }
    // Rekening gaji {bank, number, holder} & No WA guru (diisi guru sendiri)
    function validBankPhone(d) {
      return (!('bank' in d) || (d.bank is map && d.bank.keys().hasOnly(['bank', 'number', 'holder'])
                && d.bank.get('bank', '') is string && d.bank.get('bank', '').size() <= 40
                && d.bank.get('number', '') is string && d.bank.get('number', '').size() <= 40
                && d.bank.get('holder', '') is string && d.bank.get('holder', '').size() <= 80))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 20));
    }
    // Tanggal gajian tiap bulan (1–31; bulan yang lebih pendek → hari terakhir)
    function validPayDay(d) {
      return (!('payDay' in d) || d.payDay == null || (d.payDay is int && d.payDay >= 1 && d.payDay <= 31))
        && (!('payDaySince' in d) || d.payDaySince == null || (d.payDaySince is string && d.payDaySince.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }
    // Langganan lembaga masih berlaku: activeUntil (diisi server setelah bayar)
    // atau masa uji coba 14 hari sejak lembaga dibuat. Kalau habis: data tetap
    // bisa dibaca, tapi Guru Mitra tidak bisa absen & Admin tidak bisa menambah
    // murid / mengundang guru sampai diperpanjang.
    function orgActiveData(o) {
      return (o.get('activeUntil', null) is timestamp && o.activeUntil > request.time)
        || (!(o.get('activeUntil', null) is timestamp) && o.get('createdAt', null) is timestamp
            && o.createdAt + duration.value(14, 'd') > request.time);
    }
    function orgActive(orgId) { return orgActiveData(get(orgPath(orgId)).data); }
    // Satu akun hanya boleh tergabung di SATU lembaga
    function notInOtherOrg(orgId) {
      return !exists(userPath(uid()))
        || !('orgId' in get(userPath(uid())).data)
        || get(userPath(uid())).data.orgId == null
        || get(userPath(uid())).data.orgId == orgId;
    }

    // ── Profil pengguna: peran aktif & lembaga ──
    match /users/{u} {
      allow read: if signedIn() && uid() == u;
      allow create, update: if signedIn() && uid() == u
        && request.resource.data.keys().hasOnly(['orgId', 'orgRole', 'mode', 'name', 'email', 'updatedAt'])
        // orgId hanya boleh diisi kalau memang sudah jadi anggota lembaga itu
        && (!('orgId' in request.resource.data) || request.resource.data.orgId == null
            || existsAfter(memberPath(request.resource.data.orgId, u)));
      allow delete: if signedIn() && uid() == u;
    }

    // ── Kode undangan (top-level, supaya Mitra bisa mencari lembaganya dari kode) ──
    match /invites/{code} {
      // Siapa pun yang login boleh membaca 1 kode yang ia ketik (kode acak, tidak bisa ditebak).
      // Admin boleh melihat daftar undangan lembaganya.
      allow get: if signedIn();
      allow list: if signedIn() && isAdmin(resource.data.orgId);

      // Admin membuat undangan + menempati 1 kursi (slot) dalam batch yang sama
      allow create: if isAdmin(request.resource.data.orgId)
        && orgActive(request.resource.data.orgId)
        && request.resource.data.keys().hasOnly(['orgId', 'orgName', 'name', 'honor', 'emailLock', 'slot', 'status', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.createdBy == uid()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.honor is int && request.resource.data.honor >= 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.slot is int
        && getAfter(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)/slots/$(string(request.resource.data.slot))).data.code == code;

      allow update: if
        // (a) Admin mencabut undangan yang belum dipakai
        (isAdmin(resource.data.orgId)
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'revoked')
        ||
        // (b) Guru Mitra memakai undangan: sekali pakai, belum kedaluwarsa, cocok Gmail (kalau dikunci)
        (signedIn()
          && resource.data.status == 'open'
          && resource.data.expiresAt > request.time
          && (resource.data.emailLock == null || resource.data.emailLock == request.auth.token.email)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt'])
          && request.resource.data.status == 'used'
          && request.resource.data.usedBy == uid()
          && existsAfter(memberPath(resource.data.orgId, uid())));
      allow delete: if false;
    }

    // ── Lembaga ──
    match /orgs/{orgId} {
      allow read: if isMember(orgId);
      // Membuat lembaga: pembuat jadi pemilik; uji coba 14 hari dengan 2 slot Guru Mitra
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.keys().hasOnly(['name', 'logo', 'ownerUid', 'seats', 'plan', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.seats == 2
        && request.resource.data.plan == 'trial'
        && request.resource.data.createdAt == request.time
        && existsAfter(memberPath(orgId, uid()));
      // Admin hanya boleh mengubah nama & logo. Kursi/paket diatur server (pembayaran).
      allow update: if isAdmin(orgId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'logo', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
      allow delete: if false;

      // ── Riwayat pembayaran langganan lembaga (hanya ditulis server/Cloud Function) ──
      match /invoices/{iid} {
        allow read: if isAdmin(orgId);
        allow write: if false;
      }

      // ── Anggota ──
      match /members/{u} {
        // Admin melihat semua anggota; Mitra hanya melihat datanya sendiri (termasuk honor)
        allow read: if isAdmin(orgId) || (signedIn() && uid() == u);

        allow create: if signedIn() && uid() == u && notInOtherOrg(orgId) && (
          // (a) Pemilik lembaga menjadi Admin saat membuat lembaga
          (request.resource.data.role == 'admin'
            && getAfter(orgPath(orgId)).data.ownerUid == uid()
            && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'joinedAt']))
          ||
          // (b) Mitra bergabung lewat kode undangan (data diambil persis dari undangan)
          (request.resource.data.role == 'mitra'
            && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'honor', 'inviteCode', 'slot', 'sheetLink', 'joinedAt'])
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.slot == get(invitePath(request.resource.data.inviteCode)).data.slot
            && getAfter(invitePath(request.resource.data.inviteCode)).data.orgId == orgId
            && getAfter(invitePath(request.resource.data.inviteCode)).data.status == 'used'
            && getAfter(invitePath(request.resource.data.inviteCode)).data.usedBy == uid()
            && get(invitePath(request.resource.data.inviteCode)).data.status == 'open'
            && request.resource.data.name == get(invitePath(request.resource.data.inviteCode)).data.name
            && request.resource.data.honor == get(invitePath(request.resource.data.inviteCode)).data.honor)
        );

        allow update: if
          // Admin: ubah nama tampilan, honor & tanggal gajian Mitra
          (isAdmin(orgId) && resource.data.role == 'mitra'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'honor', 'payDay', 'payDaySince'])
            && request.resource.data.honor is int && request.resource.data.honor >= 0
            && validPayDay(request.resource.data))
          ||
          // Mitra: link spreadsheet absensi, rekening gaji & No WA miliknya sendiri
          (signedIn() && uid() == u && resource.data.role == 'mitra'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheetLink', 'bank', 'phone'])
            && validBankPhone(request.resource.data))
          ||
          // Guru Admin mendaftarkan / menghentikan dirinya sebagai guru (mengajar lewat
          // aplikasi Guru Mitra), mengatur honornya sendiri & link spreadsheet absensinya
          (signedIn() && uid() == u && resource.data.role == 'admin'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teaches', 'honor', 'slot', 'sheetLink', 'bank', 'phone', 'payDay', 'payDaySince'])
            && validBankPhone(request.resource.data) && validPayDay(request.resource.data)
            && request.resource.data.get('teaches', false) is bool
            && (!('honor' in request.resource.data) || (request.resource.data.honor is int && request.resource.data.honor >= 0)));

        // Admin mengeluarkan Mitra, atau Mitra keluar sendiri (Admin tidak bisa menghapus dirinya)
        allow delete: if resource.data.role == 'mitra' && (isAdmin(orgId) || (signedIn() && uid() == u));
      }

      // ── Kursi (slot) Guru Mitra: id "1".."seats" — mencegah melebihi kuota paket ──
      match /slots/{n} {
        allow read: if isAdmin(orgId);
        allow create: if isAdmin(orgId)
          && int(n) >= 1 && int(n) <= get(orgPath(orgId)).data.seats
          && orgActive(orgId)
          && (
            (request.resource.data.keys().hasOnly(['kind', 'code'])
              && request.resource.data.kind == 'invite'
              && getAfter(invitePath(request.resource.data.code)).data.orgId == orgId
              && getAfter(invitePath(request.resource.data.code)).data.slot == int(n))
            ||
            // Guru Admin yang juga mengajar (lewat aplikasi Guru Mitra) memakai 1 slot
            (request.resource.data.keys().hasOnly(['kind', 'uid'])
              && request.resource.data.kind == 'self'
              && request.resource.data.uid == uid()
              && getAfter(memberPath(orgId, uid())).data.get('teaches', false) == true
              && getAfter(memberPath(orgId, uid())).data.slot == int(n))
          );
        // Mitra yang memakai undangan mengubah kursi dari "undangan" jadi "anggota"
        allow update: if signedIn()
          && resource.data.kind == 'invite'
          && request.resource.data.keys().hasOnly(['kind', 'code', 'uid'])
          && request.resource.data.kind == 'member'
          && request.resource.data.code == resource.data.code
          && request.resource.data.uid == uid()
          && getAfter(invitePath(resource.data.code)).data.usedBy == uid();
        // Kursi dikosongkan hanya kalau penghuninya memang sudah tidak ada
        allow delete: if (isAdmin(orgId) || (signedIn() && resource.data.kind == 'member' && resource.data.uid == uid())) && (
          (resource.data.kind == 'invite'
            && (getAfter(invitePath(resource.data.code)).data.status == 'revoked'
                || get(invitePath(resource.data.code)).data.expiresAt < request.time))
          ||
          (resource.data.kind == 'member' && !existsAfter(memberPath(orgId, resource.data.uid)))
          ||
          (resource.data.kind == 'self' && isAdmin(orgId)
            && getAfter(memberPath(orgId, resource.data.uid)).data.get('teaches', false) != true)
        );
      }

      // ── Tahap 2: Mata Pelajaran (tarif standar) — hanya Admin ──
      match /subjects/{sid} {
        allow read, delete: if isAdmin(orgId);
        allow create, update: if isAdmin(orgId)
          && request.resource.data.keys().hasOnly(['name', 'rate', 'active', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.rate is int && request.resource.data.rate >= 0 && request.resource.data.rate <= 100000000
          && request.resource.data.active is bool;
      }

      // ── Tahap 2: Murid (nama ortu, No HP, tarif, kelas) — HANYA Admin ──
      // Guru Mitra tidak pernah membaca dokumen ini; jadwalnya dibaca dari /sched.
      match /students/{sid} {
        allow read, delete: if isAdmin(orgId);
        // Murid baru hanya selama langganan berlaku (data lama tetap bisa diubah)
        allow create, update: if isAdmin(orgId) && (resource != null || orgActive(orgId))
          && request.resource.data.keys().hasOnly(['name', 'parentName', 'phone', 'note', 'active', 'classes', 'source', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.active is bool
          && request.resource.data.classes is list && request.resource.data.classes.size() <= 10;
      }

      // ── Tahap 2: Jadwal per kelas (salinan ringkas untuk Guru Mitra) ──
      // Tanpa No HP & tanpa tarif. Mitra hanya bisa membaca kelas yang ditugaskan
      // kepadanya (query wajib where mitraUid == uid), dan selama masih anggota.
      match /sched/{cid} {
        allow read: if isAdmin(orgId) || (isMember(orgId) && resource.data.mitraUid == uid());
        allow create, update: if isAdmin(orgId)
          && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'subjectId', 'subjectName', 'mitraUid', 'schedule', 'active', 'updatedAt'])
          && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 80
          && (request.resource.data.mitraUid == null || request.resource.data.mitraUid is string)
          && request.resource.data.schedule is list && request.resource.data.schedule.size() <= 7
          && request.resource.data.active is bool;
        allow delete: if isAdmin(orgId);
      }

      // ── Keuangan: pembayaran murid (hanya Admin) ──
      // 1 dokumen = 1 pembayaran paket untuk 1 kelas (mis. 4x pertemuan Rp 400.000).
      match /payments/{pid} {
        allow read, delete: if isAdmin(orgId);
        allow create, update: if isAdmin(orgId)
          && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'classId', 'subjectName', 'sessions', 'amount', 'rate', 'date', 'note', 'by', 'createdAt'])
          && request.resource.data.sessions is int && request.resource.data.sessions >= 1 && request.resource.data.sessions <= 200
          && request.resource.data.amount is int && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000000
          && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      // ── Penggajian: 1 dokumen = 1 kali gaji dibayarkan ke 1 guru (dengan bukti transfer) ──
      // Hanya Admin yang menulis; guru hanya bisa membaca slip gajinya sendiri.
      match /payouts/{pid} {
        allow read: if isAdmin(orgId) || (isMember(orgId) && resource.data.mitraUid == uid());
        allow delete: if isAdmin(orgId);
        allow create: if isAdmin(orgId)
          && request.resource.data.keys().hasOnly(['mitraUid', 'mitraName', 'periodFrom', 'periodTo', 'attIds', 'hadir', 'alpa', 'sessions', 'total', 'paidDate', 'bank', 'proof', 'note', 'by', 'createdAt'])
          && request.resource.data.total is int && request.resource.data.total >= 0
          && request.resource.data.attIds is list && request.resource.data.attIds.size() <= 500
          && request.resource.data.paidDate is string && request.resource.data.paidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (!('proof' in request.resource.data) || (request.resource.data.proof is string && request.resource.data.proof.size() <= 900000));
      }
      // ── Pengaturan lembaga (mis. paket: berapa pertemuan per pembayaran) — hanya Admin ──
      match /settings/{key} {
        allow read, write: if isAdmin(orgId);
      }

      // ── Tahap 3: Absensi per sesi — id = {classId}_{YYYY-MM-DD} ──
      // Guru Mitra: hanya kelas yang ditugaskan kepadanya, hanya Hadir/Alpa,
      // hanya di HARI YANG SAMA (WIB, dengan kelonggaran untuk WITA/WIT),
      // Hadir wajib ada progres, honor = honor dia saat itu. Izin/Off hanya Admin.
      match /att/{aid} {
        function attKeys() { return ['classId', 'studentId', 'studentName', 'subjectName', 'mitraUid', 'date', 'start', 'end', 'status', 'progress', 'prSiswa', 'prGuru', 'reason', 'honor', 'by', 'updatedAt']; }
        function dayStart(d) { return timestamp.date(int(d.split('-')[0]), int(d.split('-')[1]), int(d.split('-')[2])); }
        function sameDay(d) { return request.time >= dayStart(d) - duration.value(9, 'h') && request.time < dayStart(d) + duration.value(18, 'h'); }
        function validAtt(x) {
          return x.keys().hasOnly(attKeys())
            && x.date is string && x.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && aid == x.classId + '_' + x.date
            && x.honor is int && x.honor >= 0
            && (x.status != 'hadir' || (x.progress is string && x.progress.trim().size() > 0));
        }
        function mitraWrite(x) {
          return isMember(orgId) && validAtt(x)
            && x.mitraUid == uid() && x.by == uid()
            && x.status in ['hadir', 'alpa']
            && get(/databases/$(database)/documents/orgs/$(orgId)/sched/$(x.classId)).data.mitraUid == uid()
            && x.honor == get(memberPath(orgId, uid())).data.honor
            && sameDay(x.date)
            && orgActive(orgId);
        }
        allow read: if isAdmin(orgId) || (isMember(orgId) && resource.data.mitraUid == uid());
        allow create: if (isAdmin(orgId) && validAtt(request.resource.data) && request.resource.data.status in ['hadir', 'alpa', 'izin', 'off'])
          || mitraWrite(request.resource.data);
        allow update: if (isAdmin(orgId) && validAtt(request.resource.data) && request.resource.data.status in ['hadir', 'alpa', 'izin', 'off'])
          || (resource.data.mitraUid == uid() && resource.data.status in ['hadir', 'alpa']
              && request.resource.data.classId == resource.data.classId
              && mitraWrite(request.resource.data));
        allow delete: if isAdmin(orgId)
          || (isMember(orgId) && resource.data.mitraUid == uid() && resource.data.status in ['hadir', 'alpa'] && sameDay(resource.data.date));
      }
    }
  }
}
